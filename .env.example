# Database the app and Prisma use.
# - Local dev: a local Postgres (brew install postgresql@17 && brew services start postgresql@17
#   && createdb dena_paona_dev). Never point local dev at production.
# - Production (Vercel): the Neon connection string — Neon dashboard → Connect.
#   The direct (non-pooled) URL works for both the app and migrations. If you use the
#   pooled "-pooler" URL, also set DIRECT_URL to the direct one: Prisma migrations need it.
DATABASE_URL="postgresql://YOUR_MAC_USER@localhost:5432/dena_paona_dev"
# DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Optional, local only: the production Neon URL, parked so it isn't lost. Nothing reads
# it — use it deliberately:  DATABASE_URL="$PROD_DATABASE_URL" npx prisma migrate deploy
# PROD_DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth — secret signs session cookies. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-string"
# Public URL of the app: http://localhost:3000 locally, your domain in production.
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth — console.cloud.google.com → APIs & Services → Credentials.
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID="1234567890-abcdefg.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-replace-me"
